{
  "appId": "fi.ksykmaps.wilma",
  "productName": "Wilma - Brando",
  "copyright": "© 2026 Nordbyte Studio",
  "directories": {
    "output": "dist/wilma",
    "buildResources": "build"
  },
  "files": [
    "wilma-main.js",
    "preload.js",
    "../client/public/**/*"
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "../client/public/icon-512.png",
    "publisherName": "Nordbyte Studio",
    "artifactName": "Wilma-Brando-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Wilma - Brando",
    "uninstallDisplayName": "Wilma - Brando",
    "installerHeaderIcon": "../client/public/icon-512.png",
    "installerIcon": "../client/public/icon-512.png",
    "uninstallerIcon": "../client/public/icon-512.png"
  }
}
