{
  "appId": "fi.ksykmaps.viewer",
  "productName": "KSYK Maps",
  "copyright": "© 2026 Nordbyte Studio",
  "directories": {
    "output": "dist/main",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "../client/public/**/*"
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "../client/public/icon-512.png",
    "publisherName": "Nordbyte Studio",
    "artifactName": "KSYK-Maps-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
    "icon": "../client/public/icon-512.png",
    "category": "public.app-category.education"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "../client/public/icon-512.png",
    "category": "Education"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "KSYK Maps",
    "uninstallDisplayName": "KSYK Maps"
  }
}
