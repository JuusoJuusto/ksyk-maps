{
  "appId": "fi.ksykmaps.admin",
  "productName": "KSYK Maps Admin",
  "copyright": "© 2026 Nordbyte Studio",
  "directories": {
    "output": "dist/admin",
    "buildResources": "build"
  },
  "files": [
    "admin-main.js",
    "preload.js",
    "../client/public/**/*"
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "../client/public/icon-512.png",
    "publisherName": "Nordbyte Studio",
    "artifactName": "KSYK-Maps-Admin-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "KSYK Maps Admin",
    "uninstallDisplayName": "KSYK Maps Admin"
  }
}
