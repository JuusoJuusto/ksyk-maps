<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.91.0 — Material You dynamic-color background for Android 12+.
  Uses @android:color/system_accent1_* refs which the OS remaps to
  the user's wallpaper palette. On <12 the plain drawable/ variant
  applies. Alpha layer kept ~F0 for legibility.

  system_accent1_800 → mid-dark (start)
  system_accent1_900 → dark end (contrast against light icons)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@android:color/system_accent1_800"
        android:centerColor="@android:color/system_accent1_700"
        android:endColor="@android:color/system_accent1_900"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="24dp" />
</shape>
