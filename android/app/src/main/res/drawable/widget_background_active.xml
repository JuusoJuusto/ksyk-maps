<?xml version="1.0" encoding="utf-8"?>
<!--
  "Now in class" gradient — brighter blue that draws the eye instantly
  when a lesson is currently in progress. Same corner radius as the
  idle variant for consistent shape.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#F01D4ED8"
        android:centerColor="#F03B82F6"
        android:endColor="#F06366F1"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="24dp" />
</shape>
