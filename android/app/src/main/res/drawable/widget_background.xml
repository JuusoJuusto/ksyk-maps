<?xml version="1.0" encoding="utf-8"?>
<!--
  Softer, richer navy → indigo gradient with slight purple lean.
  Higher alpha for better legibility against wallpaper without going opaque.
  Matches Apple Weather / iOS Calendar widget cadence.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#F0111827"
        android:centerColor="#F01E293B"
        android:endColor="#F0312E81"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="24dp" />
</shape>
