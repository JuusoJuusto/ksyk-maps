<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header: label + day nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TODAY'S SCHEDULE"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <!-- Prev day button — v1.87.0 way bigger tap target -->
        <TextView
            android:id="@+id/btn_prev_day"
            android:layout_width="72dp"
            android:layout_height="60dp"
            android:text="&#8249;"
            android:textSize="42sp"
            android:textColor="#DDFFFFFF"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:fontFamily="sans-serif" />

        <!-- Day display: "MON · 14" -->
        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:fontFamily="sans-serif-medium"
            android:minWidth="48dp"
            android:gravity="center" />

        <!-- Next day button — v1.87.0 way bigger tap target -->
        <TextView
            android:id="@+id/btn_next_day"
            android:layout_width="72dp"
            android:layout_height="60dp"
            android:text="&#8250;"
            android:textSize="42sp"
            android:textColor="#DDFFFFFF"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/time1"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/subject1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/room1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#66FFFFFF" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/time2"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/subject2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/room2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#66FFFFFF" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/time3"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/subject3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/room3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#66FFFFFF" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/time4"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/subject4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/room4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#66FFFFFF" />
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout
        android:id="@+id/row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/time5"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/subject5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/room5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#66FFFFFF" />
    </LinearLayout>

    <!-- Row 6 -->
    <LinearLayout
        android:id="@+id/row6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/time6"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/subject6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/room6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#66FFFFFF" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No lessons today"
        android:textSize="16sp"
        android:textColor="#55FFFFFF"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
