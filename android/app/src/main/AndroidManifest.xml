<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Timetable lesson reminders (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarm for on-time lesson reminders (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="31" />
    <!-- Re-schedule reminders after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".KsykApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="KSYK Maps"
        android:description="@string/app_description"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KSYKMaps.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="KSYK Maps"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/Theme.KSYKMaps.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ksykmaps.fi" />
                <data android:scheme="https" android:host="www.ksykmaps.fi" />
            </intent-filter>

            <!-- mpassId OAuth redirect URI — Chrome Custom Tab returns here after login -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fi.ksykmaps" android:host="auth" android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Fires the timetable lesson reminder notification -->
        <receiver
            android:name=".ui.LessonReminderReceiver"
            android:exported="false" />

        <!-- Re-schedules timetable reminders after device reboot -->
        <receiver
            android:name=".ui.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: next lesson glance -->
        <receiver
            android:name=".ui.NextLessonWidget"
            android:exported="true"
            android:label="Next Lesson">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="fi.ksykmaps.TIMETABLE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_lesson_widget_info" />
        </receiver>

        <!-- Home-screen widget: currently ongoing lesson -->
        <receiver
            android:name=".ui.CurrentLessonWidget"
            android:exported="true"
            android:label="Current Lesson">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="fi.ksykmaps.TIMETABLE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/current_lesson_widget_info" />
        </receiver>

        <!-- Home-screen widget: today's full schedule -->
        <receiver
            android:name=".ui.TodayScheduleWidget"
            android:exported="true"
            android:label="Today's Schedule">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="fi.ksykmaps.TIMETABLE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_schedule_widget_info" />
        </receiver>

    </application>
</manifest>
