# PostHog web configuration
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
# Required for PostHog's lazily loaded browser assets.
POSTHOG_CSP_SCRIPT_SRC=https://*.posthog.com

# PostHog Android configuration
POSTHOG_API_KEY=your_posthog_project_token
POSTHOG_HOST=https://your-posthog-host
