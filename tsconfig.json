{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*", "packages/**/src/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "client/src/**/*backup*",
    "client/src/**/*_backup*",
    "client/src/components/UltimateKSYKBuilder.tsx",
    "client/src/components/StaffManager.tsx",
    "client/src/components/ParentChildLinkManager.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@ksyk/shared": ["./packages/shared/src/index.ts"],
      "@ksyk/shared/*": ["./packages/shared/src/*"],
      "@ksyk/renderer": ["./packages/renderer/src/index.ts"],
      "@ksyk/renderer/*": ["./packages/renderer/src/*"],
      "@ksyk/routing": ["./packages/routing/src/index.ts"],
      "@ksyk/api": ["./packages/api/src/index.ts"]
    }
  }
}
